<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
		http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd">

    <context:annotation-config/>

    <alias name="defaultCheckoutComKlarnaProductsRequestDtoPopulator"
           alias="checkoutComKlarnaProductsRequestDtoPopulator"/>
    <bean id="defaultCheckoutComKlarnaProductsRequestDtoPopulator"
          class="com.checkout.hybris.core.payment.klarna.request.converters.populators.CheckoutComKlarnaProductsRequestDtoPopulator">
        <constructor-arg ref="checkoutComCurrencyService"/>
        <constructor-arg ref="checkoutComKlarnaDiscountAmountStrategy"/>
    </bean>

    <alias name="defaultCheckoutComKlarnaProductsRequestDtoConverter"
           alias="checkoutComKlarnaProductsRequestDtoConverter"/>
    <bean id="defaultCheckoutComKlarnaProductsRequestDtoConverter" parent="abstractPopulatingConverter">
        <property name="targetClass" value="java.util.ArrayList"/>
        <property name="populators">
            <list>
                <ref bean="checkoutComKlarnaProductsRequestDtoPopulator"/>
            </list>
        </property>
    </bean>

    <alias name="defaultCheckoutComOxxoRequestPayerDtoPopulator"
           alias="checkoutComOxxoRequestPayerDtoPopulator"/>
    <bean id="defaultCheckoutComOxxoRequestPayerDtoPopulator"
          class="com.checkout.hybris.core.payment.oxxo.request.converter.populator.CheckoutComOxxoRequestPayerDtoPopulator">
    </bean>

    <alias name="defaultCheckoutComOxxoRequestPayerDtoConverter"
           alias="checkoutComOxxoRequestPayerDtoConverter"/>
    <bean id="defaultCheckoutComOxxoRequestPayerDtoConverter" parent="abstractPopulatingConverter">
        <property name="targetClass" value="com.checkout.hybris.core.oxxo.session.request.OxxoPayerRequestDto"/>
        <property name="populators">
            <list>
                <ref bean="checkoutComOxxoRequestPayerDtoPopulator"/>
            </list>
        </property>
    </bean>

    <alias name="defaultCheckoutComCartModelToPaymentL2AndL3Converter"
           alias="checkoutComCartModelToPaymentL2AndL3Converter"/>
    <bean class="com.checkout.hybris.core.populators.payments.DefaultCheckoutComCartModelToPaymentL2AndL3Converter"
          name="defaultCheckoutComCartModelToPaymentL2AndL3Converter">
        <constructor-arg name="checkoutComCurrencyService" ref="checkoutComCurrencyService"/>
    </bean>


    <alias name="defaultCheckoutComFlowBillingAddressPopulator" alias="checkoutComFlowBillingAddressPopulator"/>
    <bean id="defaultCheckoutComFlowBillingAddressPopulator"
          class="com.checkout.hybris.core.flow.paymentsession.populators.DefaultCheckoutComFlowBillingAddressPopulator">
        <constructor-arg name="checkoutComPhoneNumberStrategy" ref="checkoutComPhoneNumberStrategy"/>
    </bean>

    <alias name="defaultCheckoutComFlowCommonPopulator" alias="checkoutComFlowCommonPopulator"/>
    <bean id="defaultCheckoutComFlowCommonPopulator"
          class="com.checkout.hybris.core.flow.paymentsession.populators.DefaultCheckoutComFlowCommonPopulator">
        <constructor-arg name="checkoutComMerchantConfigurationService" ref="checkoutComMerchantConfigurationService"/>
        <constructor-arg name="checkoutComCurrencyService" ref="checkoutComCurrencyService"/>
        <constructor-arg name="configurationService" ref="configurationService"/>
    </bean>

    <alias name="defaultCheckoutComFlowCustomerPopulator" alias="checkoutComFlowCustomerPopulator"/>
    <bean id="defaultCheckoutComFlowCustomerPopulator"
          class="com.checkout.hybris.core.flow.paymentsession.populators.DefaultCheckoutComFlowCustomerPopulator"/>

    <alias name="defaultCheckoutComFlowItemsPopulator" alias="checkoutComFlowItemsPopulator"/>
    <bean id="defaultCheckoutComFlowItemsPopulator"
          class="com.checkout.hybris.core.flow.paymentsession.populators.DefaultCheckoutComFlowItemsPopulator">
        <constructor-arg name="checkoutComCurrencyService" ref="checkoutComCurrencyService"/>
    </bean>

    <alias name="defaultCheckoutComFlowProcessingPopulator" alias="checkoutComFlowProcessingPopulator"/>
    <bean id="defaultCheckoutComFlowProcessingPopulator"
          class="com.checkout.hybris.core.flow.paymentsession.populators.DefaultCheckoutComFlowProcessingPopulator">
        <constructor-arg name="checkoutComCurrencyService" ref="checkoutComCurrencyService"/>
    </bean>

    <alias name="defaultCheckoutComFlowShippingAddressPopulator" alias="checkoutComFlowShippingAddressPopulator"/>
    <bean id="defaultCheckoutComFlowShippingAddressPopulator"
          class="com.checkout.hybris.core.flow.paymentsession.populators.DefaultCheckoutComFlowShippingAddressPopulator">
        <constructor-arg name="checkoutComPhoneNumberStrategy" ref="checkoutComPhoneNumberStrategy"/>
    </bean>

    <alias name="defaultCheckoutComFlowUrlsPopulator" alias="checkoutComFlowUrlsPopulator"/>
    <bean id="defaultCheckoutComFlowUrlsPopulator"
          class="com.checkout.hybris.core.flow.paymentsession.populators.DefaultCheckoutComFlowUrlsPopulator"/>

    <alias name="defaultCheckoutComFlowCartPaymentSessionRequestConverter" alias="checkoutComFlowCartPaymentSessionRequestConverter"/>
    <bean id="defaultCheckoutComFlowCartPaymentSessionRequestConverter" class="com.checkout.hybris.core.flow.paymentsession.converters.DefaultCheckoutComFlowCartPaymentSessionRequestConverter">
        <constructor-arg name="populatorList">
            <list>
                <ref bean="checkoutComFlowBillingAddressPopulator"/>
                <ref bean="checkoutComFlowCustomerPopulator"/>
                <ref bean="checkoutComFlowItemsPopulator"/>
                <ref bean="checkoutComFlowProcessingPopulator"/>
                <ref bean="checkoutComFlowShippingAddressPopulator"/>
                <ref bean="checkoutComFlowUrlsPopulator"/>
                <ref bean="checkoutComFlowCommonPopulator"/>
            </list>
        </constructor-arg>
    </bean>

</beans>
