{
  "compileOnSave": true,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "@checkout.com/checkout-spartacus-connector": [
        "dist/checkout-spartacus-connector"
      ],
      "@checkout.com/checkout-spartacus-translations": [
        "dist/checkout-spartacus-translations"
      ],
      "@checkout-tests/*": [
        "projects/checkout-spartacus-connector/src/tests/*"
      ]
    },
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "exclude": [
    "dist",
    "@checkout.com/checkout-spartacus-connector"
  ]
}
