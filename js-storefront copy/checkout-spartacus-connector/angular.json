{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "checkout-spartacus-connector": {
      "projectType": "library",
      "root": "projects/checkout-spartacus-connector",
      "sourceRoot": "projects/checkout-spartacus-connector/src",
      "prefix": "y",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/checkout-spartacus-connector/tsconfig.lib.json",
            "project": "projects/checkout-spartacus-connector/ng-package.json",
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/checkout-spartacus-connector/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/checkout-spartacus-connector/src/test.ts",
            "tsConfig": "projects/checkout-spartacus-connector/tsconfig.spec.json",
            "karmaConfig": "projects/checkout-spartacus-connector/karma.conf.js",
            "codeCoverageExclude": [
              "projects/checkout-spartacus-connector/src/tests/**"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules/"
              ]
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/checkout-spartacus-connector/**/*.ts",
              "projects/checkout-spartacus-connector/**/*.html"
            ]
          }
        }
      }
    },
    "example-storefront": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/example-storefront",
      "sourceRoot": "projects/example-storefront/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/example-storefront"
            },
            "index": "projects/example-storefront/src/index.html",
            "polyfills": [
              "projects/example-storefront/src/polyfills.ts"
            ],
            "tsConfig": "projects/example-storefront/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@spartacus/smartedit/assets",
                "output": "assets/"
              }
            ],
            "styles": [
              "projects/example-storefront/src/styles.scss",
              "projects/checkout-spartacus-connector/src/styles/styles.scss",
              "@angular/cdk/overlay-prebuilt.css"
            ],
            "stylePreprocessorOptions": {
              "sass": {
                "silenceDeprecations": [
                  "import"
                ]
              },
              "includePaths": [
                "node_modules/"
              ]
            },
            "allowedCommonJsDependencies": [
              "qrcode"
            ],
            "scripts": [],
            "server": "projects/example-storefront/src/main.server.ts",
            "prerender": false,
            "ssr": {
              "entry": "projects/example-storefront/src/server.ts"
            },
            "extractLicenses": true,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "projects/example-storefront/src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/example-storefront/src/environments/environment.ts",
                  "with": "projects/example-storefront/src/environments/environment.prod.ts"
                }
              ],
              "outputPath": {
                "base": "dist/example-storefront"
              },
              "index": "projects/example-storefront/src/index.html",
              "polyfills": [
                "projects/example-storefront/src/polyfills.ts"
              ],
              "tsConfig": "projects/example-storefront/tsconfig.app.json",
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "12kb"
                }
              ],
              "browser": "projects/example-storefront/src/main.ts",
              "baseHref": "/spartacus/",
              "ssr": false,
              "prerender": false
            },
            "productionSSR": {
              "fileReplacements": [
                {
                  "replace": "projects/example-storefront/src/environments/environment.ts",
                  "with": "projects/example-storefront/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "namedChunks": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "6mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "250kb",
                  "maximumError": "300kb"
                }
              ],
              "baseHref": "/spartacus/"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "ssr": false,
              "prerender": false
            },
            "localSSR": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "6mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "250kb",
                  "maximumError": "300kb"
                }
              ]
            },
            "ci": {
              "fileReplacements": [
                {
                  "replace": "projects/example-storefront/src/environments/environment.ts",
                  "with": "projects/example-storefront/src/environments/environment.ci.ts"
                }
              ],
              "outputPath": {
                "base": "dist/example-storefront"
              },
              "index": "projects/example-storefront/src/index.html",
              "polyfills": [
                "projects/example-storefront/src/polyfills.ts"
              ],
              "tsConfig": "projects/example-storefront/tsconfig.app.json",
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "12kb"
                }
              ],
              "browser": "projects/example-storefront/src/main.ts",
              "baseHref": "/spartacus/",
              "ssr": false,
              "prerender": false
            },
            "ciSSR": {
              "fileReplacements": [
                {
                  "replace": "projects/example-storefront/src/environments/environment.ts",
                  "with": "projects/example-storefront/src/environments/environment.ci.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "6mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "250kb",
                  "maximumError": "300kb"
                }
              ],
              "baseHref": "/spartacus/"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "example-storefront:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "example-storefront:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "example-storefront:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/example-storefront/**/*.ts",
              "projects/example-storefront/**/*.html"
            ]
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "styles": [
              "projects/example-storefront/src/styles.scss",
              "projects/checkout-spartacus-connector/src/styles/styles.scss",
              "@angular/cdk/overlay-prebuilt.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@spartacus/smartedit/assets",
                "output": "assets/"
              }
            ]
          }
        }
      }
    },
    "checkout-spartacus-translations": {
      "projectType": "library",
      "root": "projects/checkout-spartacus-translations",
      "sourceRoot": "projects/checkout-spartacus-translations/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/checkout-spartacus-translations/tsconfig.lib.json",
            "project": "projects/checkout-spartacus-translations/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/checkout-spartacus-translations/tsconfig.lib.prod.json"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/checkout-spartacus-translations/**/*.ts",
              "projects/checkout-spartacus-translations/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
