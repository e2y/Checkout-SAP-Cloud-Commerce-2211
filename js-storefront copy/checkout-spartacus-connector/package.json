{
  "name": "checkout-spartacus-connector",
  "version": "2211.43.0",
  "repository": "https://github.com/checkout/Checkout-SAP-Cloud-Commerce-2211",
  "config": {
    "connectorPackageName": "checkoutcom-spartacus-connector",
    "translationsPackageName": "checkoutcom-spartacus-translations"
  },
  "scripts": {
    "ng": "ng",
    "start:localtest": "yarn start --host localtest.me --ssl true --ssl-cert ssl/cert.pem --ssl-key ssl/key.pem",
    "start:secure": "yarn start --host electronics-spa.e2y.com --ssl --ssl-cert ssl/cert.pem --ssl-key ssl/key.pem",
    "start:secure2": "yarn build && ng serve --host electronics-spa.e2y.com --ssl --ssl-cert ssl/cert.pem --ssl-key ssl/key.pem",
    "start": "yarn build && ng serve",
    "build": "yarn build-translations && yarn build-libs",
    "build-prod": "yarn build-translations --configuration production && yarn build-libs --configuration production",
    "build-ci": "yarn build-prod && ng build example-storefront -c ci",
    "build:ssr": "npm run build && ng run example-storefront:build:productionSSR",
    "build:ssr:local": "npm run build && ng run example-storefront:build:localSSR",
    "build-ci-ssr": "npm run build-ci && ng run example-storefront:build:ciSSR",
    "test": "ng test",
    "test:headless": "ng test checkout-spartacus-connector --browsers ChromeHeadless",
    "test:coverage": "yarn test:headless --code-coverage --watch false",
    "ci-test": "ng test checkout-spartacus-connector --code-coverage --watch false",
    "serve:ssr": "node dist/example-storefront/server/server.mjs",
    "serve:ssr:local": "NODE_TLS_REJECT_UNAUTHORIZED='0' node dist/example-storefront/server/server.mjs --ssl",
    "serve-ci-ssr": "nohup cross-env PORT=4200 cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 node dist/example-storefront/server/server.mjs >> /dev/null 2>&1 &",
    "prerender": "ng build example-storefront --configuration=production --prerender",
    "prerenderDev": "ng build example-storefront --configuration=development --prerender",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix && yarn lint-style:fix",
    "lint-style": "stylelint \"**/*.scss\"",
    "lint-style:fix": "stylelint \"**/*.scss\" --fix",
    "build-libs": "ng build checkout-spartacus-connector",
    "watch-libs": "yarn build-libs --watch",
    "build-translations": "ng build checkout-spartacus-translations",
    "swagger": "export NODE_TLS_REJECT_UNAUTHORIZED=0 && npx openapi-typescript@5.3.0 https://localhost:9002/occ/v2/api-docs --output projects/checkout-spartacus-connector/src/generated/occ.ts",
    "clear:connector-test-package": "rm -f $npm_package_config_connectorPackageName-*.tgz && yarn cache clean && rm -rf node_modules/@checkout.com/checkout-spartacus-connector",
    "clear:translations-test-package": "rm -f $npm_package_config_translationsPackageName-*.tgz && yarn cache clean && rm -rf node_modules/@checkout.com/checkout-spartacus-translations",
    "build:connector-test-package": "cd dist/checkout-spartacus-connector && yarn pack --filename ../../$npm_package_config_connectorPackageName-$npm_package_version.tgz",
    "build:translations-test-package": "cd dist/checkout-spartacus-translations && yarn pack --filename ../../$npm_package_config_translationsPackageName-$npm_package_version.tgz",
    "build:prepare-test-packages": "npm run clear:connector-test-package && npm run clear:translations-test-package && npm run build-prod && npm run build:translations-test-package && npm run build:connector-test-package && yarn add ./$npm_package_config_translationsPackageName-$npm_package_version.tgz --force && yarn add ./$npm_package_config_connectorPackageName-$npm_package_version.tgz --force"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.20",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.20",
    "@angular/compiler": "^19.2.20",
    "@angular/core": "^19.2.20",
    "@angular/forms": "^19.2.20",
    "@angular/platform-browser": "^19.2.20",
    "@angular/platform-browser-dynamic": "^19.2.20",
    "@angular/platform-server": "^19.2.18",
    "@angular/pwa": "19.2.22",
    "@angular/router": "^19.2.20",
    "@angular/service-worker": "^19.2.20",
    "@angular/ssr": "^19.2.22",
    "@checkout.com/checkout-web-components": "^1.7.1",
    "@fontsource/open-sans": "^5.1.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@ng-select/ng-select": "^14.9.0",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/operators": "^19.2.1",
    "@ngrx/router-store": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "@ngrx/store-devtools": "^19.2.1",
    "@schematics/angular": "^19.2.22",
    "@spartacus/asm": "~2211.43.0",
    "@spartacus/assets": "~2211.43.0",
    "@spartacus/cart": "~2211.43.0",
    "@spartacus/checkout": "~2211.43.0",
