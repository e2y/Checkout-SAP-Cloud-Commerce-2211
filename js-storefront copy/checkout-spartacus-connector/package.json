    "@spartacus/order": "~2211.43.0",
    "@spartacus/pdf-invoices": "~2211.43.0",
    "@spartacus/product": "~2211.43.0",
    "@spartacus/setup": "~2211.43.0",
    "@spartacus/smartedit": "~2211.43.0",
    "@spartacus/storefinder": "~2211.43.0",
    "@spartacus/storefront": "~2211.43.0",
    "@spartacus/styles": "~2211.43.0",
    "@spartacus/tracking": "~2211.43.0",
    "@spartacus/user": "~2211.43.0",
    "@techiediaries/ngx-qrcode": "^9.1.0",
    "angular-oauth2-oidc": "^19.0.0",
    "eslint-plugin-jsdoc": "^46.8.1",
    "i18next": "^24.2.1",
    "i18next-http-backend": "^3.0.1",
    "i18next-resources-to-backend": "^1.2.1",
    "i18next-xhr-backend": "^3.2.2",
    "is-ci": "^3.0.0",
    "jsonc-parser": "^3.3.1",
    "karma-cli": "^2.0.0",
    "karma-coverage": "~2.2.0",
    "karma-junit-reporter": "^2.0.1",
    "karma-parallel": "^0.3.1",
    "logrocket": "^1.3.0",
    "ngx-infinite-scroll": "^19.0.0",
    "ngx-plaid-link": "^14.0.0",
    "parse5": "^7.1.2",
    "popper.js": "^1.16.1",
    "postcss": "8.4.31",
    "postcss-scss": "^4.0.8",
    "rxjs": "~7.8.1",
    "translations": "^2.2.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.22",
    "@angular-devkit/core": "^19.2.22",
    "@angular-devkit/schematics": "^19.2.22",
    "@angular-eslint/builder": "^19.2.1",
    "@angular-eslint/eslint-plugin": "^19.2.1",
    "@angular-eslint/eslint-plugin-template": "^19.2.1",
    "@angular-eslint/schematics": "^19.2.1",
    "@angular-eslint/template-parser": "^19.2.1",
    "@angular-eslint/utils": "^17.4.0",
    "@angular/cli": "^19.2.22",
    "@angular/compiler-cli": "^19.2.20",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.16.0",
    "@faker-js/faker": "^9.3.0",
    "@spartacus/schematics": "~2211.43.0",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "22",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@typescript-eslint/types": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jsdoc": "^46.8.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-rxjs": "^5.0.3",
    "eslint-plugin-rxjs-angular": "^2.0.1",
    "globals": "^15.13.0",
    "jasmine-core": "4.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "ng-packagr": "^19.2.2",
    "parse5": "^7.1.2",
    "stylelint": "^15.0.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^5.2.1",
    "ts-node": "^10.6.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
